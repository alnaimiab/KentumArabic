<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Console harness for the Arabic shaping pipeline.

    It compiles the *real* ArabicShaper.cs, not a copy of its logic. An earlier version of this
    harness reimplemented the RtlLayout path, which meant it could pass while the shipped code
    failed. Shaping is pure string -> string, so the only thing needed to build it standalone is
    a stub for the BepInEx logger.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>ShaperTest</AssemblyName>
    <RootNamespace>ShaperTest</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\src\KentumArabic\Shaping\RTLTMPro\**\*.cs" />
    <Compile Include="..\..\src\KentumArabic\Shaping\ArabicShaper.cs" />
    <Compile Include="LogStub.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>
</Project>
